# Long-running upload controller. Edit stream settings in upload-gate.json.
[Unit]
Description=Authenticated timed camera uploads over cellular
Requires=ranch-upload-lock.service
After=ranch-upload-lock.service NetworkManager.service ranch-hotspot.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/ranch-hotspot/upload_gate.py serve
Restart=on-failure
# Retry failed controller starts after 5 seconds, always with closed leases.
RestartSec=5
# Include worker/FFmpeg descendants in service cleanup; stop timeout is seconds.
KillMode=control-group
TimeoutStopSec=15
# Persistent replay database survives restarts; matches upload_gate.STATE.
StateDirectory=ranch-upload-gate
StateDirectoryMode=0700
UMask=0077
# Keep these restrictions aligned with worker privileges and install paths.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_KILL

[Install]
WantedBy=multi-user.target
